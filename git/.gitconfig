[core]
	editor = cursor --wait
	# editor = emacsclient -c
	excludesfile = ~/.gitignore
	# brew install delta
	pager = delta

[delta]
    line-numbers = true

[github]
	user = iquabius

[color "status"]
	added = green
	changed = red bold
	untracked = magenta bold

[color "branch"]
	remote = yellow

[alias]
	br = branch
	ci = commit
	co = checkout
	st = status
	lg = log --oneline --reverse
	# https://stackoverflow.com/a/34969726/1787829
	prune-branches = !git remote prune origin && git branch -vv | grep ': gone]' | awk '{print $1}' | xargs -r git branch -D
	undo = reset --soft HEAD^

[log]
	abbrevCommit = true

[push]
    autoSetupRemote = true

[status]
	short = true

[diff]
    tool = default-difftool
[difftool "default-difftool"]
    cmd = code --wait --diff $LOCAL $REMOTE

[difftool "latexdiff"]
[init]
	defaultBranch = main

# Hooks da configuração (git 2.54 ou mais novo), que rodam junto com os do
# repositório, inclusive o core.hooksPath local. Chamam o script pelo caminho
# no repositório, e não pelo link de ~/.local/bin: este arquivo e os scripts
# chegam juntos em qualquer pull ou reset, e o hook não fica apontando para
# um link que o stow bin ainda não criou. Por isso o clone fica em ~/.dotfiles,
# como manda o readme.md.
#
# Código só chega ao main (ou master) depois da revisão do ramo (git-revisao,
# pacote bin): o pre-push recusa código sem a marca de `git revisao pronto`,
# e o pre-commit, o commit de agente no main que mexe no código. Vale só no
# repositório que lista os caminhos de código em .config/revisao.
[hook "revisao-push"]
	event = pre-push
	command = "$HOME/.dotfiles/bin/.local/bin/git-revisao pre-push"
[hook "revisao-commit"]
	event = pre-commit
	command = "$HOME/.dotfiles/bin/.local/bin/git-revisao pre-commit"

# O merge de um ramo diz em português o que ele traz: "Junta o ramo <ramo>:
# ...", e não o "Merge branch" do git (git-assunto-merge, pacote bin). Vale
# em todo repositório; um sai com `git config hook.assunto-merge.enabled false`.
[hook "assunto-merge"]
	event = commit-msg
	command = "$HOME/.dotfiles/bin/.local/bin/git-assunto-merge commit-msg"

# Identidade e credenciais ficam na camada privada (~/.dotfiles-private → ~/.gitconfig.local)
[include]
	path = ~/.gitconfig.local
