#!/bin/sh
# Mantém caminhos absolutos de home fora do repositório.
#
# `/home/<user>/` e `/Users/<user>/` entregam o nome da conta da máquina que
# escreveu a linha. Três deles entraram aqui antes deste hook existir —
# `josiasbusiquia`, `tchuca` e `iqb` — em comentário e em settings.json.
# Use `$HOME`, `~`, ou uma variável que a própria ferramenta expanda.
#
# Só as linhas ADICIONADAS são verificadas, então ocorrência antiga não trava
# um commit que nem mexeu nela.
#
# Uma conta de sistema, que não é nome de pessoa, entra no ALLOW abaixo,
# num commit que passa pela revisão como todo hook.

set -eu

# Contas de sistema, que não são nome de pessoa.
ALLOW='linuxbrew|runner|root'

# Um diff só, do índice inteiro. Linha nova é a "+" que não saiu, como "-",
# de lugar nenhum do mesmo commit, em qualquer arquivo, uma vez por saída:
# assim a linha de um arquivo renomeado (com ou sem o -M parear os dois
# lados) ou movida para outro arquivo não conta, e a copiada conta. O -M só
# deixa o diff menor. O nome vem do cabeçalho (+++ b/<nome>, ou
# +++ "b/<nome>" com as aspas e os escapes do git quando ele tem aspas,
# barra invertida ou caractere de controle; o tab que o git põe depois do
# nome com espaço sai), e os prefixos vão explícitos para o diff.noprefix e
# o mnemonicPrefix não os trocarem, como o --submodule=short para o
# diff.submodule não pôr no diff o conteúdo de um submódulo. Linha
# do cabeçalho só conta até o primeiro @@: depois dele, "+++" é conteúdo
# que começa com "++". O --text lê como texto o binário e o arquivo que o
# atributo -diff marca (no .gitattributes ou no .git/info/attributes, que
# não vai ao repositório), para nenhum dos dois esconder a linha; o
# --no-textconv lê o conteúdo cru, e não o que o driver do .gitattributes
# faria dele. O diff vai para um arquivo, que o trap apaga também no Ctrl-C,
# e não para uma variável: o $(...) descarta os bytes NUL do binário,
# colando o que estava separado (o bash, quando é o sh, ainda avisa disso no
# stderr). Pelo mesmo motivo, e para a recusa não mandar ao terminal os
# bytes de controle de um binário, o tr troca na saída os caracteres de
# controle do ASCII, fora o tab e a quebra de linha, por "?". O awk escreve
# num segundo arquivo, que o tr lê depois: no fim de um pipe, o tr daria o
# status do pipe, e a falha do awk passaria o commit. O symlink novo, também
# o que entra no lugar de um arquivo, tem o alvo como linha "+", e conta. A
# conta do ALLOW vira "/" na linha antes da busca, até não sobrar nenhuma: a
# outra conta da mesma linha ainda recusa, e as pontas que sobram não se
# colam num caminho que não estava lá.
diff=$(mktemp)
saida=$(mktemp)
trap 'rm -f "$diff" "$saida"' EXIT
trap 'exit 1' HUP INT TERM
git -c core.quotePath=false diff --cached -M -U0 --no-color --text \
    --no-ext-diff --no-textconv --submodule=short --src-prefix=a/ \
    --dst-prefix=b/ >"$diff"

awk -v allow="$ALLOW" '
    BEGIN { ultimo = "\n" }
    /^diff --git / { cab = 1; f = ""; next }
    cab && /^\+\+\+ b\// { f = substr($0, 7); sub(/\t$/, "", f); next }
    cab && /^\+\+\+ "b\// {
        f = substr($0, 8); sub(/\t$/, "", f); sub(/"$/, "", f); next
    }
    /^@@/ { cab = 0; next }
    cab { next }
    /^-/ { saiu[substr($0, 2)]++; next }
    /^\+/ {
        t = $0
        while (gsub("/(home|Users)/(" allow ")/", "/", t)) {}
        if (t ~ /\/(home|Users)\/[A-Za-z0-9._-]+\//) {
            n++; arq[n] = f; lin[n] = substr($0, 2)
        }
    }
    END {
        for (i = 1; i <= n; i++) {
            if (saiu[lin[i]] > 0) { saiu[lin[i]]--; continue }
            if (arq[i] != ultimo) { print "  " arq[i]; ultimo = arq[i] }
            print "      " lin[i]
        }
    }' "$diff" >"$saida"
hits=$(tr '\000-\010\013-\037\177' '[?*]' <"$saida")

if [ -n "$hits" ]; then
    echo "pre-commit: caminho absoluto de home nas linhas adicionadas:" >&2
    echo >&2
    printf '%s\n' "$hits" >&2
    echo >&2
    echo "  Troque por \$HOME ou ~. Conta de sistema: acrescente-a ao ALLOW do .githooks/pre-commit." >&2
    exit 1
fi
